# Proxy de Vite para /api y /ws en desarrollo local contra un backend Django
# corriendo en tu maquina. Sin esta variable, el proxy queda deshabilitado y
# las peticiones van directo al origen del front (como en produccion).
# VITE_API_PROXY=http://localhost:8000

# URL absoluta del WebSocket de chat. Opcional: si no se define, se deriva del
# origen actual (ws(s)://<host>/ws/chat/), que funciona con el proxy de arriba
# en dev y de forma nativa en produccion (mismo dominio).
# VITE_WS_URL=wss://agente.luisacoy.me/ws/chat/
